NODE_ENV=development
PORT=8000

DATABASE_URL=postgres://kustto:kustto@localhost:5434/kustto
REDIS_URL=redis://localhost:6381
ORIGENES=http://localhost:3000

# S3: se queda. Los buckets siguen CERRADOS.
# El sitio, para los enlaces de los correos (restablecer contraseña, seguir un
# pedido). En local: http://localhost:3000. Sin él, apuntan a producción.
KUSTTO_SITIO=https://kustto.com.mx

# Cuentas propias. `pnpm auth:llave` genera la llave obligatoria.
JWT_LLAVE_PRIVADA=
JWT_LLAVE_ANTERIOR=
JWT_EMISOR=https://api.kustto.com.mx
# En producción: .kustto.com.mx. En local, vacío.
COOKIE_DOMINIO=
# false SÓLO en local sin HTTPS.
COOKIE_SEGURA=true
# true sólo si hay un proxy o balanceador delante que ponga X-Forwarded-For.
CONFIAR_EN_PROXY=false

AWS_REGION=us-east-2
# En local, el perfil del ~/.aws que el compose monta en el contenedor.
# En un servidor esto se deja VACIO y las credenciales las da el rol de la maquina.
AWS_PROFILE=kustto
S3_BUCKET_PUBLICO=kustto-publico-prod-293310830676-us-east-2-an
S3_BUCKET_PRIVADO=kustto-privado-prod-293310830676-us-east-2-an

# Correo. Sin esto no se manda y se avisa en el log; la API sirve igual.
SMTP_URL=
CORREO_DESDE=Kustto <hola@kustto.com.mx>
CORREO_SOLICITUDES=hola@kustto.com.mx

SKYDROPX_HOST=https://sb-pro.skydropx.com
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
# Vacio = se ofrecen todas. Cotizar no es poder despachar: si la credencial de
# una paqueteria no esta dada de alta, la guia se compra y muere DESPUES de que
# el cliente ya pago ese envio.
SKYDROPX_PAQUETERIAS=
SKYDROPX_WEBHOOK_SECRETO=
# Apagado a proposito: los parametros del perfil salieron de un spike y NO
# tienen validacion fisica. Nadie ha cosido todavia un diseno preparado con
# esto. El worker vive en su propia imagen (docker compose --profile bordado).
BORDADO_ACTIVO=false

# Quitar fondo: la Lambda de ISNet (kustto-infra/bg-removal). Sin las dos
# variables la función está apagada y el editor dice que no está disponible.
FONDO_BUCKET=kustto-bg-removal-prod-293310830676-us-east-2
FONDO_COLA_URL=https://sqs.us-east-2.amazonaws.com/293310830676/kustto-bg-removal-prod
