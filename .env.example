NODE_ENV=development
PORT=8000

DATABASE_URL=postgres://kustto:kustto@localhost:5432/kustto
REDIS_URL=redis://localhost:6379
ORIGENES=http://localhost:3000

# Cognito: se queda. TRES pools distintos a proposito — con uno solo, un token
# de taller abriria /cuenta/*.
COGNITO_REGION=us-east-1
COGNITO_POOL_COMPRADORES=us-east-1_UPmxJntO3
COGNITO_CLIENTE_COMPRADORES=
COGNITO_POOL_TALLERES=us-east-1_qxIsXIrrV
COGNITO_CLIENTE_TALLERES=
COGNITO_POOL_ADMINS=
COGNITO_CLIENTE_ADMINS=

# S3: se queda. Los buckets siguen CERRADOS.
AWS_REGION=us-east-1
S3_BUCKET_PUBLICO=kustto-publico-prod
S3_BUCKET_PRIVADO=kustto-privado-prod

# Correo. Sin esto no se manda y se avisa en el log; la API sirve igual.
SMTP_URL=
CORREO_DESDE=Kustto <hola@kustto.com.mx>

SKYDROPX_HOST=https://sb-pro.skydropx.com
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
# Vacio = se ofrecen todas. Cotizar no es poder despachar: si la credencial de
# una paqueteria no esta dada de alta, la guia se compra y muere DESPUES de que
# el cliente ya pago ese envio.
SKYDROPX_PAQUETERIAS=
SKYDROPX_WEBHOOK_SECRETO=
BORDADO_ACTIVO=false
