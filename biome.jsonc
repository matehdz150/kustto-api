{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	// Respeta el .gitignore: sin esto Biome revisaba `dist/` y `dist-scripts/`.
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		// Las instantáneas de drizzle-kit las escribe la herramienta, no nosotros.
		// Tampoco lo que genera kustto-web (V6.2): el contrato y el núcleo de
		// bordado se copian byte a byte, y `contrato.spec.ts` comprueba su sha256;
		// formatearlos aquí los haría distintos del paquete.
		"includes": [
			"**",
			"!migraciones/meta",
			"!src/bordado/contrato/canonical.ts",
			"!src/bordado/contrato/profile.ts",
			"!src/bordado/contrato/types.ts",
			"!src/bordado/contrato/validation.ts",
			"!src/bordado/contrato/original.ts",
			"!src/bordado/contrato/nucleo.ts",
			"!servicios/bordado/nucleo.cjs",
			"!servicios/bordado/nucleo.version.json",
			"!src/bordado/pruebas"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"parser": {
			// Nest inyecta por decoradores en los parámetros del constructor
			// (`@Inject(DB) private readonly db`). Sin esto Biome no los parsea.
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				// APAGADA A PROPÓSITO: su arreglo cambia `import { X }` por
				// `import type { X }`, y en una clase que Nest inyecta por el
				// constructor eso ROMPE la inyección —`emitDecoratorMetadata`
				// necesita la clase en tiempo de ejecución— y la API no arranca.
				// Biome no sabe que un tipo de parámetro decorado se usa como valor.
				"useImportType": "off"
			}
		}
	},
	"assist": {
		"enabled": true
	}
}
